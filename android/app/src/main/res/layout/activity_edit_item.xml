<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_card_bg"
    android:padding="22dp"
    android:layout_gravity="center">

    <TextView
        android:id="@+id/edit_item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Editar Quantidade"
        android:textColor="#FFFFFF"
        android:textSize="18.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/edit_item_product_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Nome do Produto"
        android:textColor="#9CA3AF"
        android:textSize="14sp" />

    <!-- Controles de Quantidade (-) [Número] (+) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bottom_input_bg_dark"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/edit_btn_decrement"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:background="@drawable/chip_suggestion_bg"
            android:gravity="center"
            android:text="-"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/edit_txt_quantity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="1 un"
            android:textColor="#00C853"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/edit_btn_increment"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:background="@drawable/chip_suggestion_bg"
            android:gravity="center"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Status: Marcar / Desmarcar como comprado -->
    <LinearLayout
        android:id="@+id/edit_btn_toggle_status"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_secondary"
        android:orientation="horizontal"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/edit_img_status_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_circle_outline"
            android:tint="#9CA3AF"
            android:contentDescription="Status" />

        <TextView
            android:id="@+id/edit_txt_status_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Pendente (toque para marcar como comprado)"
            android:textColor="#D1D5DB"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Botões de Ação: Excluir, Cancelar e Salvar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/edit_btn_delete"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/btn_danger"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Excluir"
            android:textColor="#EF4444"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/edit_btn_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/btn_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Cancelar"
            android:textColor="#9CA3AF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/edit_btn_save"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.3"
            android:background="@drawable/btn_primary_green"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Salvar"
            android:textColor="#FFFFFF"
            android:textSize="14.5sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
