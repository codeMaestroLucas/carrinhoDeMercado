<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark">

    <!-- Cabeçalho com Imagem Ilustrativa (ListTop.jpg) + Efeito Gradiente -->
    <RelativeLayout
        android:id="@+id/widget_header_container"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/widget_header_image_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_header_image"
            android:contentDescription="Cabeçalho ilustrativo" />

        <ImageView
            android:id="@+id/widget_header_gradient"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_header_gradient_overlay"
            android:contentDescription="@null" />

        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:id="@+id/widget_cart_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_shopping_cart"
                android:tint="#FFFFFF"
                android:contentDescription="Carrinho de Compras" />

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:text="Lista de Compras"
                android:textColor="#FFFFFF"
                android:textSize="17.5sp"
                android:textStyle="bold"
                android:shadowColor="#B3000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4" />

        </LinearLayout>

    </RelativeLayout>

    <ImageView
        android:id="@+id/widget_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/widget_header_container"
        android:background="#2E3440"
        android:contentDescription="@null" />

    <!-- Caixa de Texto na Parte Inferior (Sobreposta, para Adicionar Itens) -->
    <LinearLayout
        android:id="@+id/widget_bottom_input_box"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bottom_input_bg_dark"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/widget_bottom_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Adicionar item à lista..."
            android:textColor="#9CA3AF"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/widget_btn_bottom_add"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_add_btn_bg"
            android:src="@drawable/ic_add"
            android:scaleType="centerInside"
            android:tint="#FFFFFF"
            android:contentDescription="Adicionar item" />

    </LinearLayout>

    <!-- Lista Scrollável (Vertical) de Itens -->
    <ListView
        android:id="@+id/widget_list_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_divider"
        android:layout_above="@id/widget_bottom_input_box"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="3dp"
        android:scrollbars="vertical" />

    <!-- Mensagem de lista vazia -->
    <TextView
        android:id="@+id/widget_empty_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:text="Nenhum item na lista\nToque abaixo para adicionar"
        android:textColor="#9CA3AF"
        android:textSize="14sp" />

</RelativeLayout>
